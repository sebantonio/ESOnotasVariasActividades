{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESO_Varias_Activiades",
  "version": "0.1.205",
  "identifier": "es.seba.esovarias",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri-web.js",
    "beforeBuildCommand": "node scripts/prepare-tauri-web.js",
    "frontendDist": "../tauri-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ESO_Varias_Activiades",
        "url": "index.html",
        "width": 1200,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
